{
  "name": "multibagger-screener",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch": "node scripts/fetch-universe.mjs",
    "fetch:profiles": "node scripts/fetch-profiles.mjs",
    "fetch:signals": "node scripts/fetch-signals.mjs",
    "data": "node scripts/build-data.mjs && node scripts/build-excel.mjs",
    "refresh": "npm run fetch && npm run fetch:profiles && npm run fetch:signals && npm run data",
    "vercel-build": "node scripts/vercel-build.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "snapshot:predictions": "node scripts/snapshot-predictions.mjs",
    "track": "node scripts/build-track.mjs",
    "backtest": "node scripts/backtest/run-backtest.mjs",
    "backtest:prices": "node scripts/backtest/fetch-prices.mjs",
    "backtest:panel": "node --max-old-space-size=6144 scripts/backtest/build-panel.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "exceljs": "4.4.0",
    "vite": "5.4.11"
  }
}
